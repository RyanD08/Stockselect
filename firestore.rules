// TrueNorth — Firestore Security Rules
//
// HOW TO APPLY: Firebase Console → Firestore Database → Rules tab → replace
// the current rules with everything below → Publish.
// Claude Code cannot deploy these for you — this file is the source of
// truth to paste in, and should be kept in sync with whatever is live in
// the console.
//
// Data model this matches (see js/auth.js saveNewPortfolio/listSavedPortfolios):
//   users/{userId}                             — no documents are read/written at this level directly
//   users/{userId}/savedPortfolios/{portfolioId} — CURRENT: up to 5 independently named saved
//                                              portfolios per user (name, answers, savedAt), each
//                                              rename-able, loadable, and delete-able from My
//                                              Portfolios. The 5-saved-portfolio cap is enforced
//                                              client-side (see auth.js), not by these rules.
//   users/{userId}/watchlist/{ticker}        — CURRENT (2026-08-25): up to 20 individually
//                                              tracked tickers per user (see addToWatchlist/
//                                              listWatchlist in auth.js). The ticker itself is the
//                                              document id, not an auto-generated one -- each doc
//                                              is just { ticker, addedAt }. The 20-ticker cap is
//                                              enforced client-side, same reasoning as
//                                              savedPortfolios' own cap above.
//   users/{userId}/meta/migration            — CURRENT: a single marker doc recording whether this
//                                              user's old savedSurveys data has already been copied
//                                              into savedPortfolios (see
//                                              migrateLegacySurveysIfNeeded in auth.js). Not survey
//                                              or portfolio data itself.
//   users/{userId}/learnProgress/{lessonId}  — CURRENT (2026-08-25): the Learn section's per-lesson
//                                              completion tracking (see recordLessonCompletion in
//                                              js/learn.js). One doc per lesson, id matching the
//                                              lesson's own id (e.g. "ceo-pay-ratio"), holding just
//                                              { completed, lastScore, bestScore, total, updatedAt }
//                                              -- never the lesson content itself, which is static
//                                              and ships with the app.
//   users/{userId}/savedSurveys/{surveyId}   — LEGACY (superseded 2026-08-23b): the same feature
//                                              under its old "survey" naming, before saved results
//                                              were renamed to "portfolios." Its data is copied into
//                                              savedPortfolios above by the one-time migration; the
//                                              app no longer reads or writes this collection itself.
//   users/{userId}/savedSurvey/current       — LEGACY: a same-day-superseded single "most recent
//                                              survey" slot. The app no longer reads or writes it.
//   users/{userId}/surveys/{surveyId}        — LEGACY: an even earlier version of this feature that
//                                              saved a full, browsable history of survey+portfolio
//                                              snapshots. The app no longer reads or writes this
//                                              collection either.
//   All legacy paths are kept here, not deleted, purely so a user who
//   saved under an earlier design isn't locked out of their own old data --
//   safe to remove once you've confirmed nothing still depends on them.
//
//   shared/{shareId}                          — CURRENT (2026-08-25): public, permanent snapshots
//                                              created by the Results screen's "Share My Results"
//                                              button (see createSharedResult in auth.js).
//                                              Deliberately NOT under users/{userId} and NOT
//                                              login-gated -- the Results screen itself doesn't
//                                              require an account, so sharing it doesn't either.
//                                              Each doc holds only { riskProfile, topPriorities,
//                                              holdings: [{ticker,name,sector,tier}], createdAt } --
//                                              never the detailed rationale, financial-caution
//                                              text, or the sharer's actual survey answers, so a
//                                              shared link never exposes more than a tier badge per
//                                              holding implies.
//
// Rules:
//   - A signed-in user may read and write ONLY documents under their own
//     users/{userId} (matched against request.auth.uid, not anything
//     client-supplied) — never another user's data.
//   - Signed-out requests are rejected outright, EXCEPT reading or creating
//     a shared/{shareId} snapshot (see above) — those are intentionally
//     public. Even there, no one can update or delete an existing snapshot
//     (immutable once created), and the collection can't be listed/browsed
//     — a doc is only reachable by someone who already has its exact link.
//   - Everything not explicitly matched below is denied by the final
//     catch-all rule (default-deny), so a future collection added to this
//     database without a matching rule here is inaccessible rather than
//     silently open.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // Current: up to 5 named saved portfolios this app actually uses now.
      match /savedPortfolios/{portfolioId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Current: up to 20 individually tracked tickers (My Watchlist).
      match /watchlist/{ticker} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Current: the one-time savedSurveys -> savedPortfolios migration
      // marker (see auth.js). Same per-owner access rule as everything
      // else here, even though it isn't survey/portfolio data.
      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Current: the Learn section's per-lesson completion tracking (see
      // js/learn.js). Same per-owner access rule as everything else here.
      match /learnProgress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy (superseded 2026-08-23b): the pre-rename "savedSurveys"
      // collection. Still readable/writable by its own owner, and still
      // read once by the migration above -- see the note at the top of
      // this file.
      match /savedSurveys/{surveyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy (superseded 2026-08-23): the single-slot "most recent
      // survey" design this replaced. Kept only so that slot's data stays
      // readable/writable by its own owner -- see the note above.
      match /savedSurvey/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Legacy (superseded earlier): the original full-portfolio-snapshot,
      // browsable-history design. Same reasoning.
      match /surveys/{surveyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public, permanent share snapshots -- see the data-model note at the
    // top of this file. No auth check on get/create (that's the point),
    // but validated: only the exact fields the app writes, sane size caps
    // so this can't be abused as free-form public storage, and a
    // server-set timestamp (request.time, not client-supplied) so a
    // snapshot's creation time can't be spoofed. `list` is never granted,
    // so the collection can't be enumerated/browsed even though individual
    // docs are public -- only reachable via its own exact link.
    match /shared/{shareId} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasAll(['riskProfile', 'topPriorities', 'holdings', 'createdAt'])
                    && request.resource.data.riskProfile in ['Conservative', 'Balanced', 'Growth']
                    && request.resource.data.topPriorities is list
                    && request.resource.data.topPriorities.size() <= 5
                    && request.resource.data.holdings is list
                    && request.resource.data.holdings.size() <= 20
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Default-deny: anything not matched above (including the bare
    // users/{userId} document itself, and any other top-level collection)
    // is inaccessible to every client, signed in or not.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
