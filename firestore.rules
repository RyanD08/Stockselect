// TrueNorth — Firestore Security Rules
//
// HOW TO APPLY: Firebase Console → Firestore Database → Rules tab → replace
// the current (test-mode) rules with everything below → Publish.
// Claude Code cannot deploy these for you — this file is the source of
// truth to paste in, and should be kept in sync with whatever is live in
// the console.
//
// Data model this matches (see js/auth.js saveSurveyResult/loadSavedSurveys):
//   users/{userId}                     — no documents are read/written at this level directly
//   users/{userId}/surveys/{surveyId}  — one saved survey+portfolio snapshot per document
//
// Rules:
//   - A signed-in user may read and write ONLY documents under their own
//     users/{userId} (matched against request.auth.uid, not anything
//     client-supplied) — never another user's data.
//   - Signed-out requests are rejected outright.
//   - Everything not explicitly matched below is denied by the final
//     catch-all rule (default-deny), so a future collection added to this
//     database without a matching rule here is inaccessible rather than
//     silently open.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {

      // A user's own saved surveys: full read/write, but only for the
      // signed-in user whose uid matches this path segment.
      match /surveys/{surveyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default-deny: anything not matched above (including the bare
    // users/{userId} document itself, and any other top-level collection)
    // is inaccessible to every client, signed in or not.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
